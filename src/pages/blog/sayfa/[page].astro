---
import type { GetStaticPaths } from 'astro';
import BlogList from '../../../components/BlogList.astro';
import { getPosts, getCategories, chunk } from '../../../lib/content';

// /blog/sayfa/2, /blog/sayfa/3 ... (1. sayfa /blog adresindedir)
export const getStaticPaths = (async () => {
  const posts = await getPosts();
  const pages = chunk(posts);
  const categories = getCategories(posts);
  return pages.slice(1).map((items, i) => ({
    params: { page: String(i + 2) },
    props: { items, categories, page: i + 2, totalPages: pages.length },
  }));
}) satisfies GetStaticPaths;

const { items, categories, page, totalPages } = Astro.props;
---

<BlogList posts={items} categories={categories} page={page} totalPages={totalPages} />
