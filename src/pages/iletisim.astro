---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Photo from '../components/Photo.astro';
import YouTubeIcon from '../components/YouTubeIcon.astro';
import { site } from '../site.config';
---

<BaseLayout title="İletişim">
  <PageHeader title="İletişim" description="Yazılarla ilgili soru ve önerilerini paylaşabilirsin." />

  <section class="contact">
    <div class="container contact-grid">
      <div class="contact-cards">
        <a href={`mailto:${site.email}`} class="contact-card">
          <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.3"></rect>
            <path d="M3.5 6l8.5 7 8.5-7" fill="none" stroke="currentColor" stroke-width="1.3"></path>
          </svg>
          <span class="contact-label">E-posta</span>
          <span class="contact-value">{site.email}</span>
        </a>
        <a href={site.instagram.url} target="_blank" rel="noopener" class="contact-card">
          <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.3"></rect>
            <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.3"></circle>
            <circle cx="17.3" cy="6.7" r="1" fill="currentColor"></circle>
          </svg>
          <span class="contact-label">Instagram</span>
          <span class="contact-value">{site.instagram.handle}</span>
        </a>
        <a href={site.youtube.url} target="_blank" rel="noopener" class="contact-card">
          <YouTubeIcon size={26} />
          <span class="contact-label">YouTube</span>
          <span class="contact-value">{site.youtube.handle}</span>
        </a>
      </div>
      <div class="contact-photo"><Photo file="iletisim.jpg" alt="" /></div>
    </div>

    <div class="container">
      <p class="notice-box">Bu site terapi veya tedavi hizmeti vermez. Acil bir durumda 112'yi arayın.</p>
    </div>
  </section>
</BaseLayout>
