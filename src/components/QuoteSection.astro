---
import Photo from './Photo.astro';

interface Props {
  quote: string;
  text: string;
  image: string;
  button?: { label: string; href: string };
}
const { quote, text, image, button } = Astro.props;
---

<section class="quote section-beige">
  <div class="container quote-grid">
    <blockquote class="quote-text">
      <p>“{quote}”</p>
    </blockquote>
    <div class="quote-img"><Photo file={image} alt="" /></div>
    <div class="quote-side">
      <p>{text}</p>
      {button && <a href={button.href} class="btn">{button.label}</a>}
    </div>
  </div>
</section>
